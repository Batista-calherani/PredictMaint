# Portas publicadas no host somente em desenvolvimento local.
# O Coolify usa docker-compose.yml sem docker-compose.override.yml, entao
# o proxy acessa as portas internas dos containers sem publicar no host.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8080
DATABASE_HOST_PORT=3306

# Portas internas dos containers.
# Normalmente so altere se a plataforma exigir.
FRONTEND_PORT=3000
BACKEND_PORT=8080

# URLs usadas entre navegador, frontend e backend.
# Em producao, substitua localhost pelos dominios configurados no Coolify.
FRONTEND_URL=http://localhost:3000
# /api = o site repassa as chamadas para a API (recomendado no servidor).
# No PC também aceita o endereço direto: http://localhost:8080/api
NEXT_PUBLIC_API_URL=/api

# Banco de dados.
MYSQL_ROOT_PASSWORD=senai@123
MYSQL_DATABASE=predictmaint
MYSQL_USER=app_user
MYSQL_PASSWORD=senai@123

DB_HOST=database
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=senai@123
DB_NAME=predictmaint

# Segredo que assina o token de login. Em produção, use um texto longo e aleatório.
JWT_SECRET=troque-este-segredo-no-env

# Fuso horário do banco e da API (as telas mostram "Hoje 08:40")
TZ=America/Sao_Paulo
